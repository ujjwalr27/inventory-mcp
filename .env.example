# Copy to .env and fill in. Never commit .env.
# Create a "Server-based Application" at https://api-console.zoho.in (or your region's console)
# with redirect URI exactly: http://localhost:8765/callback

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Optional overrides
# ZOHO_REDIRECT_URI=http://localhost:8765/callback
# Accounts server the browser starts on. With multi-DC enabled, Zoho redirects
# users from other regions to their own DC and tells us which one in the callback.
# ZOHO_DEFAULT_ACCOUNTS_SERVER=https://accounts.zoho.in
# Plan drives the daily / concurrency budgets: free | standard | professional | premium | enterprise
# ZOHO_PLAN=free
# Where tokens are stored (outside the repo by default)
# ZOHO_TOKEN_DIR=~/.zoho-mcp

# Required only for `zoho-mcp serve --transport http` (remote agents such as Agent Studio).
# Clients must send `Authorization: Bearer <this value>`. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_SERVER_TOKEN=
